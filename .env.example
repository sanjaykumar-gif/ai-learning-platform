# =====================================================================
#  AI Learning Share — environment
#  Copy to .env and fill in:  cp .env.example .env
# =====================================================================

# ------------------------------------------------------------------ EVENT
EVENT_STARTS_AT=2026-09-05T19:00:00+05:30     # ISO 8601, keep the +05:30 (IST)
EVENT_DURATION_MIN=180
EVENT_PRICE_RUPEES=199
EVENT_EARLYBIRD_RUPEES=0                      # 0 = no early bird
EARLYBIRD_ENDS_AT=                            # e.g. 2026-09-01T23:59:59+05:30
EVENT_SEATS=0                                 # 0 = unlimited
REGISTRATION_CLOSES_AT=                       # e.g. 2026-09-05T18:00:00+05:30
CALENDAR_TITLE=AI Learning Share — Live Masterclass

# Revealed ONLY on the ticket of a paid participant
GOOGLE_MEET_LINK=                             # https://meet.google.com/xxx-xxxx-xxx
WHATSAPP_GROUP_LINK=                          # https://chat.whatsapp.com/XXXX
DRIVE_FOLDER_LINK=                            # https://drive.google.com/drive/folders/XXXX

# ---------------------------------------------------------------- CONTACT
WHATSAPP_NUMBER=917550321307                  # international format, no +
URGENT_CALL_NUMBER=917550321307
CONTACT_EMAIL=sanjaykumarvpk@gmail.com
ORGANIZER_NAME=Sanjay K


# --------------------------------------------------------------- SUPABASE
# Project Settings -> API. Use the SERVICE ROLE key (server side only).
SUPABASE_URL=                                 # https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=registrations
USE_LOCAL_DB=false                            # true = store in data/db.json (no Supabase)
LOCAL_DB_FILE=

# ------------------------------------------------------------------ ADMIN
ADMIN_PASSWORD=ChangeMe@123                   # organiser dashboard password (wrap in "quotes" if it contains #)
ADMIN_SESSION_HOURS=12
SERVER_SECRET=replace-with-a-long-random-string

# ----------------------------------------------------------------- SERVER
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=                              # e.g. https://ai-meet.onrender.com (for QR codes)
UPI_ID=                                  # e.g. yourname@oksbi — enables "pay with any UPI app"
